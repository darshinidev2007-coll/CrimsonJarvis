<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050103"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/crimson_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRIMSON JARVIS"
                android:textColor="#FF1E42"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="OWNER: DARSHINI • VOICE LOCK: UNENROLLED"
                android:textColor="#D49AA6"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/crimson_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnSpeak"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:backgroundTint="#C90E33"
                android:text="🩸
SPEAK"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Ready for your command, Darshini."
                android:textColor="#FFD6DE"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="No voice input yet."
                android:textColor="#A87480"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCommand"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/crimson_card"
                    android:hint="Type: Call Amma / Open WhatsApp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFEEF2"
                    android:textColorHint="#8A5A65"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnRun"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#C90E33"
                    android:text="RUN"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/crimson_card"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnEnroll"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#B80D2F"
                android:text="🎙️ Enroll Darshini's Voice Lock (3s)"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnService"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#4A0816"
                android:text="🟢 Start 24/7 Wake Service ('Hey Jarvis')"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#32050F"
                android:text="⚙️ Enable Screen Pilot (Accessibility)"
                android:textColor="#FFD6DE"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#32050F"
                android:text="🔓 Allow Display Over Other Apps"
                android:textColor="#FFD6DE" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
